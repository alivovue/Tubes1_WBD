{
  "name": "schakker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "src/frontend",
    "src-admin/frontend",
    "shared/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:user": "npm run build --workspace=schakker-frontend",
    "build:admin": "npm run build --workspace=schakker-admin-frontend",
    "typecheck:shared": "npm run typecheck --workspace=@schakker/ui"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
