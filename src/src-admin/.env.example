# The admin server reads only src-admin/.env when using the launcher.
SCHAKKER_ADMIN_DATABASE_URL=
# Existing 32-byte encryption key, hex or base64. During cutover use the old
# connection-encryption key here; never silently generate a replacement.
SCHAKKER_ADMIN_MASTER_KEY=
SCHAKKER_ADMIN_ENV=development
SCHAKKER_ADMIN_PORT=3001
SCHAKKER_ADMIN_INTERNAL_ADDR=127.0.0.1:3002
# At least 32 random bytes; provision the same service token in the user app.
SCHAKKER_INTERNAL_TOKEN=
# Required in production and for any non-loopback internal listener.
SCHAKKER_ADMIN_INTERNAL_TLS_CERT=
SCHAKKER_ADMIN_INTERNAL_TLS_KEY=
