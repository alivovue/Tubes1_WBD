{{define "content"}}
<section class="page-heading page-heading--compact"><div><p class="eyebrow">Database explorer</p><h1>{{if .Database.ID}}{{.Database.Name}}{{else}}Database Explorer{{end}}</h1><p>{{.Database.DBMS}} · {{permission .Database.Permission}}</p></div><div class="heading-actions"><a class="button button--secondary" href="/databases">Change database</a>{{if .Database.ID}}<a class="button button--secondary" href="{{link "/migrations" "db" .Database.ID}}">Changelog</a>{{end}}{{if .CanEdit}}<a class="button button--primary" href="{{link "/migrations/new" "db" .Database.ID}}">New migration</a>{{end}}</div></section>
{{if .Database.ID}}
<section class="explorer-shell">
 <aside class="schema-panel" aria-label="Database objects"><div class="tree"><strong>{{.Database.Name}}</strong>
 {{range .Schemas}}<a class="tree__schema {{if eq $.Schema .Name}}is-active{{end}}" href="{{link "/explorer" "db" $.Database.ID "schema" .Name}}"><svg><use href="#icon-database"></use></svg>{{.Name}}</a>{{end}}
 <label class="search-box search-box--small"><svg><use href="#icon-search"></use></svg><input type="search" placeholder="Find table..." data-table-search /></label>
 <div class="tree__items">{{range .Tables}}<a class="tree__item {{if eq $.Table .Name}}is-active{{end}}" href="{{link "/explorer" "db" $.Database.ID "schema" $.Schema "table" .Name}}" data-table-name="{{.Name}}"><svg><use href="#icon-table"></use></svg>{{.Name}}</a>{{else}}<p class="empty-state">No tables in this schema.</p>{{end}}<p class="tree__empty" data-table-search-empty hidden>No matching tables.</p></div>
 </div></aside>
 <div class="object-panel">
 {{if .Detail}}
 <header class="object-panel__header"><div><span class="object-icon"><svg><use href="#icon-table"></use></svg></span><div><p>{{.Schema}} / {{.Detail.Table.Kind}}</p><h2>{{.Table}}</h2></div></div></header>
 <div class="tabs" role="tablist" aria-label="Table details">
 <button class="tab is-active" role="tab" aria-selected="true" aria-controls="columns-panel" id="columns-tab" data-tab="columns-panel">Columns <span>{{len .Detail.Columns}}</span></button><button class="tab" role="tab" aria-selected="false" aria-controls="constraints-panel" id="constraints-tab" data-tab="constraints-panel">Constraints <span>{{len .Detail.Constraints}}</span></button><button class="tab" role="tab" aria-selected="false" aria-controls="indexes-panel" id="indexes-tab" data-tab="indexes-panel">Indexes <span>{{len .Detail.Indexes}}</span></button><button class="tab" role="tab" aria-selected="false" aria-controls="rows-panel" id="rows-tab" data-tab="rows-panel">Data</button>
 </div>
 <section id="columns-panel" data-tab-panel role="tabpanel" aria-labelledby="columns-tab"><div class="table-wrap"><table class="data-table"><thead><tr><th>Column</th><th>Type</th><th>Nullable</th><th>Default / Generated</th></tr></thead><tbody>{{range .Detail.Columns}}<tr><td><code>{{.Name}}</code></td><td>{{.DataType}}</td><td>{{if .Nullable}}Yes{{else}}No{{end}}</td><td>{{if .GeneratedExpression}}{{.GeneratedExpression}}{{else if .Default}}{{.Default}}{{end}}{{if .Identity}} · Identity {{.Identity}}{{end}}</td></tr>{{end}}</tbody></table></div></section>
 <section id="constraints-panel" data-tab-panel role="tabpanel" aria-labelledby="constraints-tab" hidden><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Type</th><th>Definition</th></tr></thead><tbody>{{range .Detail.Constraints}}<tr><td>{{.Name}}</td><td>{{.Type}}</td><td><code>{{.Definition}}</code>{{if .ReferencedTable}}<small>References {{.ReferencedSchema}}.{{.ReferencedTable}} ({{range .ReferencedColumns}}{{.}} {{end}}) · UPDATE {{.UpdateRule}} · DELETE {{.DeleteRule}}</small>{{end}}</td></tr>{{else}}<tr><td colspan="3">No constraints.</td></tr>{{end}}</tbody></table></div></section>
 <section id="indexes-panel" data-tab-panel role="tabpanel" aria-labelledby="indexes-tab" hidden><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Method</th><th>Unique</th><th>Definition</th></tr></thead><tbody>{{range .Detail.Indexes}}<tr><td>{{.Name}}</td><td>{{.Method}}</td><td>{{if .Unique}}Yes{{else}}No{{end}}</td><td><code>{{.Definition}}</code></td></tr>{{else}}<tr><td colspan="4">No indexes.</td></tr>{{end}}</tbody></table></div></section>
 <section id="rows-panel" data-tab-panel role="tabpanel" aria-labelledby="rows-tab" hidden>
 <form class="toolbar" method="get" action="/explorer"><input type="hidden" name="db" value="{{.Database.ID}}" /><input type="hidden" name="schema" value="{{.Schema}}" /><input type="hidden" name="table" value="{{.Table}}" /><input type="hidden" name="tab" value="rows-panel" /><label class="field"><span>Sort column</span><select name="sort"><option value="">Default order</option>{{range .Detail.Columns}}<option value="{{.Name}}" {{if eq .Name $.Sort}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label class="field"><span>Direction</span><select name="direction"><option value="asc" {{if ne .Direction "desc"}}selected{{end}}>Ascending</option><option value="desc" {{if eq .Direction "desc"}}selected{{end}}>Descending</option></select></label><button class="button button--secondary button--small" type="submit">Apply</button></form>
 <div class="table-wrap"><table class="data-table"><thead><tr>{{range .Data.Columns}}<th>{{.Name}}</th>{{end}}</tr></thead><tbody>{{range .Data.Rows}}<tr>{{range .}}<td>{{cell .}}</td>{{end}}</tr>{{else}}<tr><td>No rows.</td></tr>{{end}}</tbody></table></div>
 <footer class="pagination"><span>{{len .Data.Rows}} rows · offset {{.Offset}}</span><div>{{if gt .Offset 0}}<a class="button button--secondary button--small" href="{{link "/explorer" "db" .Database.ID "schema" .Schema "table" .Table "sort" .Sort "direction" .Direction "offset" .Previous "tab" "rows-panel"}}">Previous</a>{{end}}{{if .HasMore}}<a class="button button--secondary button--small" href="{{link "/explorer" "db" .Database.ID "schema" .Schema "table" .Table "sort" .Sort "direction" .Direction "offset" .Next "tab" "rows-panel"}}">Next</a>{{end}}</div></footer>
 </section>
 {{else}}<p class="empty-state">Select a schema with tables to inspect.</p>{{end}}
 </div>
</section>
{{else}}<p class="empty-state">No databases assigned. Contact your platform admin.</p>{{end}}
{{end}}
