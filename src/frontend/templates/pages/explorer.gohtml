{{define "content"}}
<section class="page-heading page-heading--compact">
  <div><p class="eyebrow">Database explorer</p><div class="heading-line"><h1>production_core</h1><span class="badge badge--danger"><i></i>Production</span><span class="badge badge--edit"><svg><use href="#icon-edit"></use></svg>View + Edit</span></div><p>PostgreSQL 16.2 · ap-southeast-3 · Last synced just now</p></div>
  <div class="heading-actions"><a class="button button--secondary" href="/databases">Change database</a><a class="button button--primary" href="/migrations/new"><svg><use href="#icon-plus"></use></svg>New migration</a></div>
</section>

<section class="explorer-shell">
  <aside class="schema-panel" aria-label="Database objects">
    <label class="search-box search-box--small"><svg><use href="#icon-search"></use></svg><input type="search" placeholder="Find table..." /></label>
    <div class="tree">
      <button class="tree__root" type="button"><svg><use href="#icon-database"></use></svg><strong>production_core</strong><svg class="tree__chevron"><use href="#icon-chevron"></use></svg></button>
      <div class="tree__branch">
        <button class="tree__schema" type="button"><svg class="tree__chevron tree__chevron--open"><use href="#icon-chevron"></use></svg><span>public</span><small>8 tables</small></button>
        <div class="tree__items">
          <button class="tree__item is-active" type="button"><svg><use href="#icon-table"></use></svg>employees</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>departments</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>customers</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>orders</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>order_items</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>products</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>payments</button>
          <button class="tree__item" type="button"><svg><use href="#icon-table"></use></svg>audit_logs</button>
        </div>
        <button class="tree__schema" type="button"><svg class="tree__chevron"><use href="#icon-chevron"></use></svg><span>reporting</span><small>4 views</small></button>
        <button class="tree__schema" type="button"><svg class="tree__chevron"><use href="#icon-chevron"></use></svg><span>extensions</span><small>2 tables</small></button>
      </div>
    </div>
  </aside>

  <div class="object-panel">
    <header class="object-panel__header"><div><span class="object-icon"><svg><use href="#icon-table"></use></svg></span><div><p>public / table</p><h2>employees</h2></div></div><button class="icon-button" type="button" aria-label="Table actions">•••</button></header>
    <div class="tabs" role="tablist" aria-label="Detail table">
      <button class="tab is-active" role="tab" aria-selected="true" aria-controls="columns-panel" id="columns-tab" data-tab="columns-panel">Columns <span>8</span></button>
      <button class="tab" role="tab" aria-selected="false" aria-controls="constraints-panel" id="constraints-tab" data-tab="constraints-panel">Constraints <span>3</span></button>
      <button class="tab" role="tab" aria-selected="false" aria-controls="indexes-panel" id="indexes-tab" data-tab="indexes-panel">Indexes <span>2</span></button>
      <button class="tab" role="tab" aria-selected="false" aria-controls="data-panel" id="data-tab" data-tab="data-panel">Data <span>2,481</span></button>
    </div>

    <div class="tab-panel" role="tabpanel" id="columns-panel" aria-labelledby="columns-tab" data-tab-panel>
      <div class="table-wrap"><table class="data-table data-table--schema"><thead><tr><th>Name</th><th>Data type</th><th>Nullable</th><th>Default</th><th>Key</th></tr></thead><tbody>
        <tr><td><strong>id</strong></td><td><code>uuid</code></td><td>No</td><td><code>gen_random_uuid()</code></td><td><span class="key-tag">PK</span></td></tr>
        <tr><td><strong>employee_code</strong></td><td><code>varchar(20)</code></td><td>No</td><td>—</td><td><span class="key-tag key-tag--unique">UQ</span></td></tr>
        <tr><td><strong>full_name</strong></td><td><code>varchar(120)</code></td><td>No</td><td>—</td><td>—</td></tr>
        <tr><td><strong>email</strong></td><td><code>varchar(255)</code></td><td>No</td><td>—</td><td><span class="key-tag key-tag--unique">UQ</span></td></tr>
        <tr><td><strong>department_id</strong></td><td><code>uuid</code></td><td>Yes</td><td><code>NULL</code></td><td><span class="key-tag key-tag--foreign">FK</span></td></tr>
        <tr><td><strong>status</strong></td><td><code>employee_status</code></td><td>No</td><td><code>'active'</code></td><td>—</td></tr>
        <tr><td><strong>created_at</strong></td><td><code>timestamptz</code></td><td>No</td><td><code>now()</code></td><td>—</td></tr>
        <tr><td><strong>updated_at</strong></td><td><code>timestamptz</code></td><td>No</td><td><code>now()</code></td><td>—</td></tr>
      </tbody></table></div>
    </div>
    <div class="tab-panel" role="tabpanel" id="constraints-panel" aria-labelledby="constraints-tab" data-tab-panel hidden>
      <div class="detail-list"><article><span class="key-tag">PK</span><div><strong>employees_pkey</strong><p>PRIMARY KEY (id)</p></div></article><article><span class="key-tag key-tag--unique">UQ</span><div><strong>employees_email_key</strong><p>UNIQUE (email)</p></div></article><article><span class="key-tag key-tag--foreign">FK</span><div><strong>employees_department_id_fkey</strong><p>FOREIGN KEY (department_id) REFERENCES departments(id)</p></div></article></div>
    </div>
    <div class="tab-panel" role="tabpanel" id="indexes-panel" aria-labelledby="indexes-tab" data-tab-panel hidden>
      <div class="detail-list"><article><span class="object-icon"><svg><use href="#icon-layers"></use></svg></span><div><strong>employees_pkey</strong><p>CREATE UNIQUE INDEX employees_pkey ON public.employees USING btree (id)</p></div></article><article><span class="object-icon"><svg><use href="#icon-layers"></use></svg></span><div><strong>employees_email_key</strong><p>CREATE UNIQUE INDEX employees_email_key ON public.employees USING btree (email)</p></div></article></div>
    </div>
    <div class="tab-panel" role="tabpanel" id="data-panel" aria-labelledby="data-tab" data-tab-panel hidden>
      <div class="table-wrap"><table class="data-table"><thead><tr><th>employee_code</th><th>full_name</th><th>email</th><th>status</th><th>created_at</th></tr></thead><tbody><tr><td>EMP-1001</td><td>Aditya Pratama</td><td>aditya.p@schakker.id</td><td><span class="badge badge--success">Active</span></td><td>2025-08-14 09:21</td></tr><tr><td>EMP-1002</td><td>Nadia Savitri</td><td>nadia.s@schakker.id</td><td><span class="badge badge--success">Active</span></td><td>2025-08-17 10:03</td></tr><tr><td>EMP-1003</td><td>Rizky Mahendra</td><td>rizky.m@schakker.id</td><td><span class="badge badge--neutral">Inactive</span></td><td>2025-09-02 14:42</td></tr></tbody></table></div>
      <footer class="pagination"><span>Showing 1–3 of 2,481 rows</span><div><button class="button button--secondary button--small" type="button" disabled>Previous</button><button class="button button--secondary button--small" type="button">Next</button></div></footer>
    </div>
  </div>
</section>
{{end}}
