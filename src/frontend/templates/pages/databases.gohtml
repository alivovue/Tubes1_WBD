{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Workspace</p><h1>My Databases</h1><p>Database yang dapat Anda akses berdasarkan keanggotaan grup.</p></div><a class="button button--secondary" href="/migrations">View changelog</a></section>
<section class="toolbar"><label class="search-box"><svg><use href="#icon-search"></use></svg><input type="search" placeholder="Search databases..." data-search-input /></label><span>{{len .Databases}} databases</span></section>
<section class="database-grid" data-filter-items aria-label="Daftar database">
{{range .Databases}}
 <article class="database-card" data-filter-item data-search="{{.Name}} {{.DBMS}} {{.DatabaseName}}">
  <div class="database-card__top"><span class="db-mark db-mark--blue">{{initials .Name}}</span><span class="badge badge--neutral">{{.DBMS}}</span></div>
  <h2>{{.Name}}</h2><p>{{.DatabaseName}}</p>
  <div class="database-card__footer"><span class="badge {{if eq .Permission "view_edit"}}badge--edit{{else}}badge--view{{end}}">{{permission .Permission}}</span><a class="button button--secondary button--small" href="{{link "/explorer" "db" .ID}}">Open explorer</a></div>
 </article>
{{else}}<p class="empty-state">No databases assigned. Contact your platform admin.</p>{{end}}
<p class="empty-state" data-filter-empty hidden>No matching databases.</p>
</section>
{{end}}
