{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Access Control</h1><p>Atur permission grup untuk setiap koneksi database.</p></div><button class="button button--primary" type="button" data-toast="Perubahan access matrix memerlukan endpoint backend.">Save changes</button></section>
<div class="notice"><svg><use href="#icon-shield"></use></svg><div><strong>Highest permission wins</strong><p>Jika karyawan tergabung dalam beberapa grup, permission efektif mengikuti tingkat tertinggi: No Access &lt; View Only &lt; View + Edit.</p></div></div>
<section class="panel access-panel">
  <header class="panel__header"><div><h2>Group database permissions</h2><p>Pilih hak akses untuk setiap kombinasi grup dan database.</p></div><span class="draft-indicator">No unsaved changes</span></header>
  <div class="table-wrap"><table class="data-table access-table"><thead><tr><th>Group</th><th><span class="access-db"><i class="db-mark db-mark--blue">P</i><span>production_core<small>Production</small></span></span></th><th><span class="access-db"><i class="db-mark db-mark--violet">A</i><span>analytics_warehouse<small>Staging</small></span></span></th><th><span class="access-db"><i class="db-mark db-mark--pink">I</i><span>identity_service<small>Development</small></span></span></th><th><span class="access-db"><i class="db-mark db-mark--green">S</i><span>sandbox_lab<small>Development</small></span></span></th></tr></thead><tbody>
    <tr><td><span class="group-name"><i class="group-icon group-icon--blue"><svg><use href="#icon-layers"></use></svg></i><span><strong>Platform Engineering</strong><small>5 members</small></span></span></td><td><select class="permission-select permission-select--edit" aria-label="Platform Engineering production_core"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td><td><select class="permission-select permission-select--view" aria-label="Platform Engineering analytics_warehouse"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Platform Engineering identity_service"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Platform Engineering sandbox_lab"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td></tr>
    <tr><td><span class="group-name"><i class="group-icon group-icon--pink"><svg><use href="#icon-layers"></use></svg></i><span><strong>Data Engineering</strong><small>7 members</small></span></span></td><td><select class="permission-select permission-select--view" aria-label="Data Engineering production_core"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Data Engineering analytics_warehouse"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td><td><select class="permission-select" aria-label="Data Engineering identity_service"><option selected>No Access</option><option>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Data Engineering sandbox_lab"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td></tr>
    <tr><td><span class="group-name"><i class="group-icon group-icon--violet"><svg><use href="#icon-layers"></use></svg></i><span><strong>Backend</strong><small>9 members</small></span></span></td><td><select class="permission-select permission-select--view" aria-label="Backend production_core"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select" aria-label="Backend analytics_warehouse"><option selected>No Access</option><option>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Backend identity_service"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td><td><select class="permission-select permission-select--edit" aria-label="Backend sandbox_lab"><option>No Access</option><option>View Only</option><option selected>View + Edit</option></select></td></tr>
    <tr><td><span class="group-name"><i class="group-icon group-icon--green"><svg><use href="#icon-layers"></use></svg></i><span><strong>Analytics</strong><small>6 members</small></span></span></td><td><select class="permission-select permission-select--view" aria-label="Analytics production_core"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--view" aria-label="Analytics analytics_warehouse"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select" aria-label="Analytics identity_service"><option selected>No Access</option><option>View Only</option><option>View + Edit</option></select></td><td><select class="permission-select permission-select--view" aria-label="Analytics sandbox_lab"><option>No Access</option><option selected>View Only</option><option>View + Edit</option></select></td></tr>
  </tbody></table></div>
</section>
{{end}}
