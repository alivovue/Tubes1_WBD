{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Access Control</h1><p>Permission diberikan melalui grup untuk setiap database.</p></div></section>
<div class="notice"><div><strong>Highest permission wins</strong><p>No Access &lt; View Only &lt; View + Edit. Platform admins also need group access to browse or change a database. Permission changes revoke affected sessions.</p></div></div>
<section class="panel access-panel"><header class="panel__header"><h2>Group database permissions</h2></header><div class="table-wrap"><table class="data-table access-table"><thead><tr><th>Group</th>{{range .Admin.Databases}}<th>{{.Name}}<small>{{.DBMS}}{{if not .Active}} · Disabled{{end}}</small></th>{{end}}</tr></thead><tbody>
{{range .GrantRows}}{{$group:=.Group}}<tr><td>{{$group.Name}}</td>{{range .Cells}}<td><form method="post" action="/admin/access"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="set_grant" /><input type="hidden" name="id" value="{{$group.ID}}" /><input type="hidden" name="db" value="{{.Database.ID}}" /><select class="permission-select" name="permission" aria-label="{{$group.Name}} {{.Database.Name}}"><option value="" {{if eq .Permission ""}}selected{{end}}>No Access</option><option value="view_only" {{if eq .Permission "view_only"}}selected{{end}}>View Only</option><option value="view_edit" {{if eq .Permission "view_edit"}}selected{{end}}>View + Edit</option></select><button class="button button--secondary button--small" type="submit">Save</button></form></td>{{end}}</tr>{{else}}<tr><td>Create groups and register connections to assign access.</td></tr>{{end}}
</tbody></table></div></section>
{{end}}
