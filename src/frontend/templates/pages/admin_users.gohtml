{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Employees</h1><p>Kelola akun, peran platform, dan status karyawan.</p></div><a class="button button--secondary" href="/admin/groups">Manage memberships</a></section>
<section class="panel"><header class="panel__header"><div><h2>Add employee</h2><p>Passwords must contain 12–72 bytes. Promotions rotate session tokens. Password changes, demotions and deactivation revoke sessions.</p></div></header>
<form class="form-stack integration-form" method="post" action="/admin/users">
 <input type="hidden" name="csrf" value="{{.CSRF}}" /><input type="hidden" name="action" value="create_user" />
 <div class="form-grid"><label class="field"><span>Username</span><input name="username" required minlength="3" maxlength="100" autocomplete="off" /></label><label class="field"><span>Display name</span><input name="display" required maxlength="150" /></label><label class="field"><span>Initial password</span><input type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password" /></label></div>
 <label class="check-control"><input type="checkbox" name="admin" /><span>Platform Admin</span></label><button class="button button--primary" type="submit">Create employee</button>
</form></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Employee</th><th>Username</th><th>Role</th><th>Status</th><th>Edit</th></tr></thead><tbody>
{{range .Admin.Users}}<tr><td>{{.DisplayName}}</td><td><code>{{.Username}}</code></td><td>{{if .IsAdmin}}Platform Admin{{else}}Employee{{end}}</td><td>{{if .Active}}Active{{else}}Disabled{{end}}</td><td><details><summary>Edit account</summary>
 <form class="form-stack inline-editor" method="post" action="/admin/users"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="update_user" /><input type="hidden" name="id" value="{{.ID}}" />
 <label class="field"><span>Display name</span><input name="display" value="{{.DisplayName}}" required maxlength="150" /></label>
 <label class="field"><span>New password (leave blank to keep)</span><input type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" /></label>
 <label class="check-control"><input type="checkbox" name="admin" {{if .IsAdmin}}checked{{end}} /><span>Platform Admin</span></label><label class="check-control"><input type="checkbox" name="active" {{if .Active}}checked{{end}} /><span>Active</span></label>
 <button class="button button--primary button--small" type="submit">Save account</button></form></details></td></tr>
{{else}}<tr><td colspan="5">No employees.</td></tr>{{end}}
</tbody></table></div></section>
{{end}}
