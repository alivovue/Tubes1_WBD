{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Employees</h1><p>Kelola akun karyawan dan keanggotaan grup.</p></div><button class="button button--primary" type="button" data-toast="Form tambah employee memerlukan endpoint backend."><svg><use href="#icon-plus"></use></svg>Add employee</button></section>
<section class="metrics-grid metrics-grid--compact"><article class="metric-card"><span class="metric-card__icon metric-card__icon--blue"><svg><use href="#icon-users"></use></svg></span><div><span>Total employees</span><strong>24</strong><small>22 active accounts</small></div></article><article class="metric-card"><span class="metric-card__icon metric-card__icon--pink"><svg><use href="#icon-shield"></use></svg></span><div><span>Platform admins</span><strong>3</strong><small>System-wide access</small></div></article><article class="metric-card"><span class="metric-card__icon metric-card__icon--violet"><svg><use href="#icon-layers"></use></svg></span><div><span>Groups</span><strong>6</strong><small>4 permission groups</small></div></article></section>
<section class="toolbar toolbar--panel"><label class="search-box"><svg><use href="#icon-search"></use></svg><input type="search" placeholder="Search name or username..." /></label><div class="filter-group"><button class="chip is-active" type="button">All</button><button class="chip" type="button">Active</button><button class="chip" type="button">Inactive</button></div></section>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Employee</th><th>Username</th><th>Groups</th><th>Role</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
  <tr><td><span class="person-inline"><i class="avatar avatar--tiny">IN</i><span><strong>Ishak Napitupulu</strong><small>ishak.n@schakker.id</small></span></span></td><td><code>ishak.n</code></td><td><span class="tag-list"><span>Platform Engineering</span><span>DB Admins</span></span></td><td>Platform Admin</td><td><span class="badge badge--success"><i></i>Active</span></td><td><button class="row-action" type="button" aria-label="Edit Ishak">•••</button></td></tr>
  <tr><td><span class="person-inline"><i class="avatar avatar--tiny avatar--pink">NS</i><span><strong>Nadia Savitri</strong><small>nadia.s@schakker.id</small></span></span></td><td><code>nadia.s</code></td><td><span class="tag-list"><span>Data Engineering</span></span></td><td>Employee</td><td><span class="badge badge--success"><i></i>Active</span></td><td><button class="row-action" type="button" aria-label="Edit Nadia">•••</button></td></tr>
  <tr><td><span class="person-inline"><i class="avatar avatar--tiny avatar--violet">RM</i><span><strong>Rizky Mahendra</strong><small>rizky.m@schakker.id</small></span></span></td><td><code>rizky.m</code></td><td><span class="tag-list"><span>Backend</span><span>Analytics</span></span></td><td>Employee</td><td><span class="badge badge--success"><i></i>Active</span></td><td><button class="row-action" type="button" aria-label="Edit Rizky">•••</button></td></tr>
  <tr><td><span class="person-inline"><i class="avatar avatar--tiny avatar--muted">DP</i><span><strong>Dewi Permata</strong><small>dewi.p@schakker.id</small></span></span></td><td><code>dewi.p</code></td><td><span class="tag-list"><span>Analytics</span></span></td><td>Employee</td><td><span class="badge badge--neutral"><i></i>Inactive</span></td><td><button class="row-action" type="button" aria-label="Edit Dewi">•••</button></td></tr>
</tbody></table></div><footer class="pagination"><span>Showing 1–4 of 24 employees</span><div><button class="button button--secondary button--small" type="button" disabled>Previous</button><button class="button button--secondary button--small" type="button">Next</button></div></footer></section>
{{end}}
