{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Database Connections</h1><p>Daftarkan target PostgreSQL atau MariaDB. Koneksi diperiksa sebelum disimpan.</p></div></section>
<section class="panel"><header class="panel__header"><div><h2>Add connection</h2><p>Credentials are encrypted in the website database.</p></div></header><form class="form-stack integration-form" method="post" action="/admin/connections"><input type="hidden" name="csrf" value="{{.CSRF}}" /><input type="hidden" name="action" value="save_connection" />
 <div class="form-grid"><label class="field"><span>Display name</span><input name="name" required maxlength="150" /></label><label class="field"><span>DBMS</span><select name="dbms">{{range .DBMS}}<option value="{{.}}" {{if eq . "postgresql"}}selected{{end}}>{{.}}</option>{{end}}</select></label><label class="field"><span>Host</span><input name="host" required autocomplete="off" /></label><label class="field"><span>Port (blank uses DBMS default)</span><input name="port" type="number" min="1" max="65535" /></label><label class="field"><span>Database name</span><input name="database_name" required /></label><label class="field"><span>Username</span><input name="username" required autocomplete="off" /></label><label class="field"><span>Password</span><input name="password" type="password" autocomplete="new-password" /></label><label class="field"><span>TLS</span><select name="sslmode"><option value="verify-full">Verify server certificate</option><option value="require">Require TLS</option><option value="disable">Disable (local development)</option></select></label></div>
 <label class="check-control"><input type="checkbox" name="active" checked /><span>Active</span></label><button class="button button--primary" type="submit">Test & save connection</button>
</form></section>
<section class="connection-list">
{{range .Admin.Databases}}<article class="connection-card integration-connection"><div class="connection-card__main"><span class="db-mark db-mark--blue">{{initials .Name}}</span><div><h2>{{.Name}}</h2><p>{{.DBMS}} · {{.Host}}:{{.Port}} / {{.DatabaseName}}</p><span class="badge badge--neutral">{{if .Active}}Active{{else}}Disabled{{end}}</span></div></div>
 <details><summary>Connection settings</summary><form class="form-stack inline-editor" method="post" action="/admin/connections"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="id" value="{{.ID}}" />
 <div class="form-grid"><label class="field"><span>Display name</span><input name="name" value="{{.Name}}" required maxlength="150" /></label><label class="field"><span>DBMS</span><select name="dbms">{{$dbms:=.DBMS}}{{range $.DBMS}}<option value="{{.}}" {{if eq . $dbms}}selected{{end}}>{{.}}</option>{{end}}</select></label><label class="field"><span>Host</span><input name="host" value="{{.Host}}" required /></label><label class="field"><span>Port</span><input name="port" type="number" min="1" max="65535" value="{{.Port}}" required /></label><label class="field"><span>Database name</span><input name="database_name" value="{{.DatabaseName}}" required /></label><label class="field"><span>Username (blank keeps current)</span><input name="username" autocomplete="off" /></label><label class="field"><span>Password (blank keeps current)</span><input name="password" type="password" autocomplete="new-password" /></label><label class="field"><span>TLS</span><select name="sslmode"><option value="verify-full" {{if eq .SSLMode "verify-full"}}selected{{end}}>Verify server certificate</option><option value="require" {{if eq .SSLMode "require"}}selected{{end}}>Require TLS</option><option value="disable" {{if eq .SSLMode "disable"}}selected{{end}}>Disable (local development)</option></select></label></div>
 <label class="check-control"><input type="checkbox" name="active" {{if .Active}}checked{{end}} /><span>Active</span></label><div class="heading-actions"><button class="button button--secondary" type="submit" name="action" value="test_connection">Test connection</button><button class="button button--primary" type="submit" name="action" value="save_connection">Save connection</button></div></form></details>
 {{if .Active}}<form method="post" action="/admin/connections"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="id" value="{{.ID}}" /><button class="button button--danger button--small" type="submit" name="action" value="disable_connection">Disable connection</button></form>{{end}}
</article>{{else}}<p class="empty-state">No connections registered.</p>{{end}}
</section>
{{end}}
