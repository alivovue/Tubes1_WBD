{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Database Connections</h1><p>Kelola konfigurasi koneksi database yang tersedia di platform.</p></div><button class="button button--primary" type="button" data-toast="Form koneksi memerlukan penyimpanan secret di backend."><svg><use href="#icon-plus"></use></svg>Add connection</button></section>
<div class="notice"><svg><use href="#icon-shield"></use></svg><div><strong>Credentials are protected</strong><p>Password tidak pernah ditampilkan kembali. Perubahan konfigurasi dan uji koneksi akan dicatat pada audit log.</p></div></div>
<section class="connection-list">
  <article class="connection-card"><div class="connection-card__main"><span class="db-mark db-mark--blue">P</span><div><div class="heading-line"><h2>production_core</h2><span class="badge badge--danger">Production</span></div><p>prod-db.internal.schakker.id:5432 · PostgreSQL 16.2</p></div></div><dl><div><dt>Status</dt><dd><span class="connection-status"><i></i>Connected</span></dd></div><div><dt>Last checked</dt><dd>2 min ago</dd></div><div><dt>SSL mode</dt><dd>Verify full</dd></div><div><dt>Managed by</dt><dd>Platform Engineering</dd></div></dl><div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test queued.">Test connection</button><button class="row-action" type="button" aria-label="Edit production_core">•••</button></div></article>
  <article class="connection-card"><div class="connection-card__main"><span class="db-mark db-mark--violet">A</span><div><div class="heading-line"><h2>analytics_warehouse</h2><span class="badge badge--neutral">Staging</span></div><p>analytics-db.internal.schakker.id:5432 · PostgreSQL 15.6</p></div></div><dl><div><dt>Status</dt><dd><span class="connection-status"><i></i>Connected</span></dd></div><div><dt>Last checked</dt><dd>7 min ago</dd></div><div><dt>SSL mode</dt><dd>Require</dd></div><div><dt>Managed by</dt><dd>Data Engineering</dd></div></dl><div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test queued.">Test connection</button><button class="row-action" type="button" aria-label="Edit analytics_warehouse">•••</button></div></article>
  <article class="connection-card"><div class="connection-card__main"><span class="db-mark db-mark--pink">I</span><div><div class="heading-line"><h2>identity_service</h2><span class="badge badge--warning">Development</span></div><p>identity-db.dev.schakker.id:5432 · PostgreSQL 16.1</p></div></div><dl><div><dt>Status</dt><dd><span class="connection-status"><i></i>Connected</span></dd></div><div><dt>Last checked</dt><dd>12 min ago</dd></div><div><dt>SSL mode</dt><dd>Require</dd></div><div><dt>Managed by</dt><dd>Backend</dd></div></dl><div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test queued.">Test connection</button><button class="row-action" type="button" aria-label="Edit identity_service">•••</button></div></article>
</section>
{{end}}
