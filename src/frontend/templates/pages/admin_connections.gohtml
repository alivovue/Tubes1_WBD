{{define "content"}}
<section class="page-heading">
  <div><p class="eyebrow">Administration</p><h1>Database Connections</h1><p>Kelola konfigurasi koneksi database yang tersedia di platform.</p></div>
  <button class="button button--primary" type="button" data-toast="Form koneksi belum tersedia: backend belum memiliki handler penyimpanan koneksi."><svg><use href="#icon-plus"></use></svg>Add connection</button>
</section>
<div class="notice"><svg><use href="#icon-shield"></use></svg><div><strong>Credential storage contract defined</strong><p>Skema menyediakan <code>encrypted_password</code>, tetapi enkripsi dan endpoint pengelolaan koneksi belum diimplementasikan backend.</p></div></div>
<section class="connection-list">
  <article class="connection-card">
    <div class="connection-card__main"><span class="db-mark db-mark--blue">P</span><div><div class="heading-line"><h2>production_core</h2><span class="badge badge--neutral">Preview</span></div><p>prod-db.internal.schakker.id:5432 · PostgreSQL</p></div></div>
    <dl><div><dt>Status</dt><dd><span class="connection-status connection-status--unknown"><i></i>Not verified</span></dd></div><div><dt>Last checked</dt><dd>Never</dd></div><div><dt>DBMS type</dt><dd>PostgreSQL</dd></div><div><dt>Managed by</dt><dd>Not available</dd></div></dl>
    <div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test belum tersedia: backend belum memiliki handler koneksi.">Test connection</button><button class="row-action" type="button" aria-label="Edit production_core" data-toast="Edit connection belum tersedia: backend belum memiliki handler perubahan koneksi.">•••</button></div>
  </article>
  <article class="connection-card">
    <div class="connection-card__main"><span class="db-mark db-mark--violet">A</span><div><div class="heading-line"><h2>analytics_warehouse</h2><span class="badge badge--neutral">Preview</span></div><p>analytics-db.internal.schakker.id:5432 · PostgreSQL</p></div></div>
    <dl><div><dt>Status</dt><dd><span class="connection-status connection-status--unknown"><i></i>Not verified</span></dd></div><div><dt>Last checked</dt><dd>Never</dd></div><div><dt>DBMS type</dt><dd>PostgreSQL</dd></div><div><dt>Managed by</dt><dd>Not available</dd></div></dl>
    <div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test belum tersedia: backend belum memiliki handler koneksi.">Test connection</button><button class="row-action" type="button" aria-label="Edit analytics_warehouse" data-toast="Edit connection belum tersedia: backend belum memiliki handler perubahan koneksi.">•••</button></div>
  </article>
  <article class="connection-card">
    <div class="connection-card__main"><span class="db-mark db-mark--pink">I</span><div><div class="heading-line"><h2>identity_service</h2><span class="badge badge--neutral">Preview</span></div><p>identity-db.dev.schakker.id:5432 · PostgreSQL</p></div></div>
    <dl><div><dt>Status</dt><dd><span class="connection-status connection-status--unknown"><i></i>Not verified</span></dd></div><div><dt>Last checked</dt><dd>Never</dd></div><div><dt>DBMS type</dt><dd>PostgreSQL</dd></div><div><dt>Managed by</dt><dd>Not available</dd></div></dl>
    <div class="connection-card__actions"><button class="button button--secondary button--small" type="button" data-toast="Connection test belum tersedia: backend belum memiliki handler koneksi.">Test connection</button><button class="row-action" type="button" aria-label="Edit identity_service" data-toast="Edit connection belum tersedia: backend belum memiliki handler perubahan koneksi.">•••</button></div>
  </article>
</section>
{{end}}
