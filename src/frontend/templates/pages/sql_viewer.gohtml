{{define "content"}}
<section class="page-heading page-heading--compact"><div><p class="eyebrow">Read workspace</p><h1>SQL Viewer</h1><p>Build or write a SELECT query, then explore the results.</p></div><span class="badge badge--view">Read only</span></section>
<form class="toolbar" method="get" action="/sql-viewer"><label class="field"><span>Target database · View Only / View + Edit</span><select name="db">{{range .Databases}}<option value="{{.ID}}" {{if eq .ID $.Database.ID}}selected{{end}}>{{.Name}} · {{.DBMS}}</option>{{end}}</select></label><button class="button button--secondary" type="submit">Select database</button></form>
{{if .Database.ID}}
<div class="toolbar viewer-object-picker">
 <form method="get" action="/sql-viewer"><input type="hidden" name="db" value="{{.Database.ID}}" /><label class="field"><span>Schema</span><select name="schema">{{range .Schemas}}<option value="{{.Name}}" {{if eq .Name $.Schema}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><button class="button button--secondary button--small" type="submit">Select schema</button></form>
 <form method="get" action="/sql-viewer"><input type="hidden" name="db" value="{{.Database.ID}}" /><input type="hidden" name="schema" value="{{.Schema}}" /><label class="field"><span>Table for visual builder</span><select name="table">{{range .Tables}}<option value="{{.Name}}" {{if eq .Name $.Table}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><button class="button button--secondary button--small" type="submit">Select table</button></form>
</div>
<form method="post" action="/sql-viewer" data-viewer-form>
 <input type="hidden" name="csrf" value="{{.CSRF}}" /><input type="hidden" name="db" value="{{.Database.ID}}" /><input type="hidden" name="schema" value="{{.Schema}}" /><input type="hidden" name="table" value="{{.Table}}" />
 <div class="migration-layout viewer-layout">
  <section class="panel editor-panel"><header class="panel__header"><div><h2>SQL editor</h2><p>{{.Database.Name}} · {{.Database.DBMS}}</p></div><span class="badge badge--view">Read only</span></header>
   <div class="code-editor"><div class="code-editor__bar"><span>query.sql</span><span>SELECT / WITH</span></div><div class="code-editor__body"><textarea name="sql" spellcheck="false" aria-label="Read-only SQL query" data-viewer-sql placeholder="SELECT * FROM your_table LIMIT 100;">{{.SQL}}</textarea></div></div>
   <p class="integration-form muted">Run one SELECT query at a time. Joins, read-only CTEs, subqueries and common aggregate functions are supported. Results are limited to 500 rows.</p>
   <div class="editor-actions"><button class="button button--primary" name="action" value="run_query" type="submit" data-viewer-run>Run read query</button></div>
  </section>
  <aside class="panel guidance-panel"><header class="panel__header"><h2>Read tools</h2></header><div class="integration-form viewer-guide"><p><strong>SELECT</strong> · Choose columns or use <code>*</code>.</p><p><strong>WHERE</strong> · Filter matching records.</p><p><strong>ORDER BY</strong> · Sort your results.</p><p><strong>GROUP BY</strong> · Summarize with <code>COUNT</code>, <code>SUM</code> or <code>AVG</code>.</p><p><strong>LIMIT / OFFSET</strong> · Read a smaller result window.</p><p class="muted">This workspace cannot change data or database structures.</p></div></aside>
 </div>
 {{if .Detail}}<section class="panel viewer-builder" data-read-builder><header class="panel__header"><div><h2>Visual SELECT builder</h2><p>{{.Schema}}.{{.Table}} · Generate SQL, review it in the editor, then run the query.</p></div></header><div class="integration-form form-stack">
  <fieldset class="viewer-columns"><legend>Columns · leave empty to select all</legend><div>{{range .Detail.Columns}}<label class="check-control"><input type="checkbox" name="columns" value="{{.Name}}" {{if hasString $.ViewerSpec.Columns .Name}}checked{{end}} /><span>{{.Name}} <small class="muted">{{.DataType}}</small></span></label>{{end}}</div></fieldset>
  <label class="check-control"><input type="checkbox" name="distinct" {{if .ViewerSpec.Distinct}}checked{{end}} /><span>DISTINCT · omit duplicate result rows</span></label>
  <div><h3>Filters · all conditions must match</h3><div data-read-filters data-filters="{{json .ViewerSpec.Filters}}" data-columns="{{json .Detail.Columns}}"></div><button class="button button--secondary button--small" type="button" data-read-filter-add>Add filter</button><noscript><p>Enable JavaScript to add visual filters. You can also write WHERE directly in the SQL editor.</p></noscript></div>
  <div class="form-grid"><label class="field"><span>Sort column</span><select name="sort"><option value="">No sorting</option>{{range .Detail.Columns}}<option value="{{.Name}}" {{if $.ViewerSpec.OrderBy}}{{if eq .Name (index $.ViewerSpec.OrderBy 0).Name}}selected{{end}}{{end}}>{{.Name}}</option>{{end}}</select></label><label class="field"><span>Direction</span><select name="direction"><option value="asc">Ascending</option><option value="desc" {{if .ViewerSpec.OrderBy}}{{if (index .ViewerSpec.OrderBy 0).Descending}}selected{{end}}{{end}}>Descending</option></select></label><label class="field"><span>Limit</span><input name="limit" type="number" min="1" max="500" value="{{.ViewerSpec.Limit}}" /></label><label class="field"><span>Offset</span><input name="offset" type="number" min="0" max="1000000" value="{{.ViewerSpec.Offset}}" /></label></div>
  <div><button class="button button--secondary" name="action" value="build_query" type="submit">Generate SELECT in editor</button></div>
 </div></section>{{end}}
</form>
{{if .ViewerResult}}<section class="panel viewer-results" data-viewer-results><header class="panel__header"><div><h2>Query results</h2><p>{{len .ViewerResult.Rows}} rows · {{.ViewerResult.Duration.Milliseconds}} ms{{if .ViewerResult.HasMore}} · first 500 rows shown; use LIMIT / OFFSET to read another window{{end}}</p></div><span class="badge badge--view">Read only</span></header><p class="notice notice--warning" data-viewer-result-stale hidden>SQL changed. Run the query again to refresh these results.</p><div class="table-wrap"><table class="data-table"><thead><tr>{{range .ViewerResult.Columns}}<th>{{.Name}}{{if .DataType}}<small class="viewer-result-type">{{.DataType}}</small>{{end}}</th>{{end}}</tr></thead><tbody>{{range .ViewerResult.Rows}}<tr>{{range .}}<td>{{cell .}}</td>{{end}}</tr>{{else}}<tr><td colspan="{{len .ViewerResult.Columns}}">Query completed. No matching rows.</td></tr>{{end}}</tbody></table></div></section>{{end}}
{{else}}<p class="empty-state">No databases assigned. SQL Viewer requires View Only or View + Edit access. Contact your platform admin.</p>{{end}}
{{end}}
