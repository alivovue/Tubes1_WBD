{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">{{stamp .Now}}</p><h1>Welcome, {{.User.DisplayName}}.</h1><p>Ringkasan database dan perubahan yang dapat Anda akses.</p></div></section>
<section class="metrics-grid" aria-label="Ringkasan">
 <article class="metric-card"><div><span>Accessible databases</span><strong>{{len .Databases}}</strong><small>Based on group permissions</small></div></article>
 <article class="metric-card"><div><span>Editable databases</span><strong>{{.EditableCount}}</strong><small>View + Edit</small></div></article>
 <article class="metric-card"><div><span>Account role</span><strong class="metric-card__permission">{{if .User.IsAdmin}}Platform Admin{{else}}Employee{{end}}</strong><small>Database access is granted separately</small></div></article>
 <article class="metric-card"><div><span>Session expires</span><strong class="metric-card__permission">{{stamp .Expires}}</strong><small>Idle timeout: 30 minutes</small></div></article>
</section>
<section class="panel"><header class="panel__header"><div><h2>Your databases</h2><p>Akses efektif menggunakan permission tertinggi dari semua grup.</p></div></header><div class="table-wrap"><table class="data-table"><thead><tr><th>Database</th><th>DBMS</th><th>Permission</th><th>Actions</th></tr></thead><tbody>
{{range .Databases}}<tr><td><a href="{{link "/explorer" "db" .ID}}">{{.Name}}</a></td><td>{{.DBMS}}</td><td>{{permission .Permission}}</td><td><a class="text-link" href="{{link "/migrations" "db" .ID}}">Changelog</a></td></tr>{{else}}<tr><td colspan="4">No databases assigned. Contact a platform admin for group access.</td></tr>{{end}}
</tbody></table></div></section>
<section class="panel"><header class="panel__header"><div><h2>Recent migrations</h2><p>Latest attempts across your databases.</p></div></header><div class="table-wrap"><table class="data-table"><thead><tr><th>Database</th><th>Migration</th><th>Executor</th><th>Time</th><th>Status</th></tr></thead><tbody>
{{range .Recent}}<tr><td>{{.DatabaseName}}</td><td><a href="{{link "/migrations" "db" .DatabaseID "id" .ID}}">{{if .Description}}{{.Description}}{{else}}Attempt #{{.ID}}{{end}}</a></td><td>{{.Username}}</td><td>{{stamp .StartedAt}}</td><td>{{.Status}}</td></tr>{{else}}<tr><td colspan="5">No migration history yet.</td></tr>{{end}}
</tbody></table></div></section>
{{end}}
