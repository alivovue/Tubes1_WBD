{{define "content"}}
<section class="page-heading">
  <div><p class="eyebrow">Saturday, 24 October 2026</p><h1>Good morning, Ishak.</h1><p>Berikut ringkasan workspace database Anda hari ini.</p></div>
  <a class="button button--primary" href="/databases"><svg><use href="#icon-database"></use></svg>Open database</a>
</section>

<section class="metrics-grid" aria-label="Ringkasan">
  <article class="metric-card"><span class="metric-card__icon metric-card__icon--blue"><svg><use href="#icon-database"></use></svg></span><div><span>Accessible databases</span><strong>4</strong><small><i class="status-dot status-dot--ok"></i>Semua koneksi sehat</small></div></article>
  <article class="metric-card"><span class="metric-card__icon metric-card__icon--pink"><svg><use href="#icon-code"></use></svg></span><div><span>Migrations this month</span><strong>18</strong><small class="trend-up">↗ 12% dari bulan lalu</small></div></article>
  <article class="metric-card"><span class="metric-card__icon metric-card__icon--violet"><svg><use href="#icon-history"></use></svg></span><div><span>Pending review</span><strong>3</strong><small>Menunggu tindakan Anda</small></div></article>
  <article class="metric-card"><span class="metric-card__icon metric-card__icon--green"><svg><use href="#icon-shield"></use></svg></span><div><span>Access level</span><strong class="metric-card__permission">Platform Admin</strong><small>Full administrative access</small></div></article>
</section>

<div class="dashboard-grid">
  <section class="panel panel--span-2">
    <header class="panel__header"><div><h2>Recent databases</h2><p>Database yang baru saja Anda akses.</p></div><a class="text-link" href="/databases">View all <svg><use href="#icon-arrow"></use></svg></a></header>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Database</th><th>Environment</th><th>Permission</th><th>Last opened</th><th><span class="sr-only">Action</span></th></tr></thead>
        <tbody>
          <tr><td><a class="database-cell" href="/explorer"><span class="db-mark db-mark--blue">P</span><span><strong>production_core</strong><small>PostgreSQL 16.2</small></span></a></td><td><span class="badge badge--danger">Production</span></td><td><span class="badge badge--edit"><svg><use href="#icon-edit"></use></svg>View + Edit</span></td><td>12 minutes ago</td><td><a class="row-action" href="/explorer" aria-label="Buka production_core"><svg><use href="#icon-chevron"></use></svg></a></td></tr>
          <tr><td><a class="database-cell" href="/explorer"><span class="db-mark db-mark--violet">A</span><span><strong>analytics_warehouse</strong><small>PostgreSQL 15.6</small></span></a></td><td><span class="badge badge--neutral">Staging</span></td><td><span class="badge badge--view"><svg><use href="#icon-eye"></use></svg>View Only</span></td><td>Yesterday</td><td><a class="row-action" href="/explorer" aria-label="Buka analytics_warehouse"><svg><use href="#icon-chevron"></use></svg></a></td></tr>
          <tr><td><a class="database-cell" href="/explorer"><span class="db-mark db-mark--pink">I</span><span><strong>identity_service</strong><small>PostgreSQL 16.1</small></span></a></td><td><span class="badge badge--warning">Development</span></td><td><span class="badge badge--edit"><svg><use href="#icon-edit"></use></svg>View + Edit</span></td><td>2 days ago</td><td><a class="row-action" href="/explorer" aria-label="Buka identity_service"><svg><use href="#icon-chevron"></use></svg></a></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel activity-panel">
    <header class="panel__header"><div><h2>Recent activity</h2><p>Aktivitas terbaru workspace.</p></div></header>
    <ol class="activity-list">
      <li><span class="activity-icon activity-icon--success"><svg><use href="#icon-check"></use></svg></span><div><strong>Migration v042 completed</strong><p>production_core · by You</p><time>12 minutes ago</time></div></li>
      <li><span class="activity-icon activity-icon--info"><svg><use href="#icon-users"></use></svg></span><div><strong>Employee added to group</strong><p>nadia.s → Data Engineering</p><time>1 hour ago</time></div></li>
      <li><span class="activity-icon activity-icon--warning"><svg><use href="#icon-key"></use></svg></span><div><strong>Access permission updated</strong><p>Analytics · View Only</p><time>Yesterday</time></div></li>
      <li><span class="activity-icon"><svg><use href="#icon-server"></use></svg></span><div><strong>Connection verified</strong><p>identity_service</p><time>2 days ago</time></div></li>
    </ol>
    <a class="button button--secondary button--wide" href="/migrations">View full activity</a>
  </section>
</div>

<section class="quick-start">
  <div><span class="quick-start__icon"><svg><use href="#icon-code"></use></svg></span><div><p class="eyebrow">Quick action</p><h2>Ready to ship a database change?</h2><p>Tulis SQL, analisis dampaknya, lalu tinjau sebelum eksekusi.</p></div></div>
  <a class="button button--light" href="/migrations/new">Create migration <svg><use href="#icon-arrow"></use></svg></a>
</section>
{{end}}
