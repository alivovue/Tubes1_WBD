{{define "content"}}
<section class="page-heading">
  <div><p class="eyebrow">Audit trail</p><h1>Migration Changelog</h1><p>Riwayat linear perubahan skema pada seluruh database yang dapat Anda akses.</p></div>
  <a class="button button--primary" href="/migrations/new"><svg><use href="#icon-plus"></use></svg>New migration</a>
</section>
<section class="toolbar toolbar--panel">
  <label class="search-box"><svg><use href="#icon-search"></use></svg><input type="search" placeholder="Search version, description, or executor..." /></label>
  <label class="compact-select"><span class="sr-only">Database</span><select><option>All databases</option><option>production_core</option><option>identity_service</option><option>sandbox_lab</option></select></label>
  <label class="compact-select"><span class="sr-only">Status</span><select><option>All statuses</option><option>Success</option><option>Failed</option><option>Rolled back</option></select></label>
</section>
<section class="panel history-panel">
  <div class="table-wrap"><table class="data-table data-table--history"><thead><tr><th>Version</th><th>Migration</th><th>Database</th><th>Executor</th><th>Executed at</th><th>Status</th><th><span class="sr-only">Action</span></th></tr></thead><tbody>
    <tr><td><code>v042</code></td><td><strong>Add last login tracking</strong><small>2 statements · 1 warning</small></td><td><span class="database-inline"><i class="db-mark db-mark--blue">P</i>production_core</span></td><td><span class="person-inline"><i class="avatar avatar--tiny">IN</i>Ishak N.</span></td><td>24 Oct 2026<small>09:42 WIB</small></td><td><span class="badge badge--success"><i></i>Success</span></td><td><button class="row-action" type="button" aria-label="Detail v042"><svg><use href="#icon-chevron"></use></svg></button></td></tr>
    <tr><td><code>v041</code></td><td><strong>Create order audit trigger</strong><small>4 statements</small></td><td><span class="database-inline"><i class="db-mark db-mark--blue">P</i>production_core</span></td><td><span class="person-inline"><i class="avatar avatar--tiny avatar--pink">NS</i>Nadia S.</span></td><td>22 Oct 2026<small>16:18 WIB</small></td><td><span class="badge badge--success"><i></i>Success</span></td><td><button class="row-action" type="button" aria-label="Detail v041"><svg><use href="#icon-chevron"></use></svg></button></td></tr>
    <tr><td><code>v040</code></td><td><strong>Change payment reference length</strong><small>3 statements · transaction rolled back</small></td><td><span class="database-inline"><i class="db-mark db-mark--blue">P</i>production_core</span></td><td><span class="person-inline"><i class="avatar avatar--tiny avatar--violet">RM</i>Rizky M.</span></td><td>21 Oct 2026<small>11:03 WIB</small></td><td><span class="badge badge--failed"><i></i>Failed</span></td><td><button class="row-action" type="button" aria-label="Detail v040"><svg><use href="#icon-chevron"></use></svg></button></td></tr>
    <tr><td><code>v039</code></td><td><strong>Add employee status enum</strong><small>3 statements</small></td><td><span class="database-inline"><i class="db-mark db-mark--pink">I</i>identity_service</span></td><td><span class="person-inline"><i class="avatar avatar--tiny">IN</i>Ishak N.</span></td><td>19 Oct 2026<small>14:26 WIB</small></td><td><span class="badge badge--success"><i></i>Success</span></td><td><button class="row-action" type="button" aria-label="Detail v039"><svg><use href="#icon-chevron"></use></svg></button></td></tr>
    <tr><td><code>v038</code></td><td><strong>Remove deprecated session token</strong><small>2 statements</small></td><td><span class="database-inline"><i class="db-mark db-mark--pink">I</i>identity_service</span></td><td><span class="person-inline"><i class="avatar avatar--tiny avatar--pink">NS</i>Nadia S.</span></td><td>18 Oct 2026<small>10:11 WIB</small></td><td><span class="badge badge--success"><i></i>Success</span></td><td><button class="row-action" type="button" aria-label="Detail v038"><svg><use href="#icon-chevron"></use></svg></button></td></tr>
  </tbody></table></div>
  <footer class="pagination"><span>Showing 1–5 of 42 migrations</span><div><button class="button button--secondary button--small" type="button" disabled>Previous</button><button class="button button--secondary button--small" type="button">Next</button></div></footer>
</section>
{{end}}
