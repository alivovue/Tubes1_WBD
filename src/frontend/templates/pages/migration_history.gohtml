{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Workspace</p><h1>Changelog</h1><p>Linear history of execution attempts for each database.</p></div>{{if .CanEdit}}<a class="button button--primary" href="{{link "/migrations/new" "db" .Database.ID}}">Create migration</a>{{end}}</section>
<form class="toolbar" method="get" action="/migrations"><label class="field"><span>Database</span><select name="db">{{range .Databases}}<option value="{{.ID}}" {{if eq .ID $.Database.ID}}selected{{end}}>{{.Name}} · {{permission .Permission}}</option>{{end}}</select></label><button class="button button--secondary" type="submit">Open history</button></form>
{{if .Database.ID}}
{{if .Execution}}<section class="panel"><header class="panel__header"><div><h2>Attempt #{{.Execution.ID}} · {{.Execution.Status}}</h2><p>{{.Execution.Description}}</p></div></header><div class="integration-form">
 <dl class="detail-grid"><div><dt>Applied version</dt><dd>{{if .Execution.AppliedVersion}}v{{.Execution.AppliedVersion}}{{else}}—{{end}}</dd></div><div><dt>Attempted version</dt><dd>{{.Execution.AttemptedVersion}}</dd></div><div><dt>Executor</dt><dd>{{.Execution.Username}}</dd></div><div><dt>Started</dt><dd>{{stamp .Execution.StartedAt}}</dd></div><div><dt>Mode</dt><dd>{{.Execution.Mode}}</dd></div><div><dt>Committed statements</dt><dd>{{.Execution.CompletedStatements}} / {{.Execution.TotalStatements}}</dd></div></dl>
 {{if .Execution.ErrorMessage}}<div class="notice notice--warning" role="alert"><div>{{.Execution.ErrorMessage}}</div></div>{{end}}
 <label class="field"><span>Executed SQL</span><textarea class="review-editor" readonly>{{.Execution.SQL}}</textarea></label>
 {{if and $.CanEdit (eq .Execution.Status "running")}}<form method="post" action="/migrations"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="db" value="{{$.Database.ID}}" /><button class="button button--secondary" type="submit" name="action" value="reconcile">Reconcile from target receipt</button></form>
 {{if and $.User.IsAdmin (eq .Execution.Mode "non_atomic")}}<details><summary>Resolve an ambiguous outcome</summary><p>Verify the actual target database state before confirming the result. Your reason will be recorded in history.</p><form class="form-stack" method="post" action="/migrations" data-confirm="Record this manually verified execution outcome?"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="db" value="{{$.Database.ID}}" /><input type="hidden" name="id" value="{{.Execution.ID}}" /><label class="field"><span>Verified outcome</span><select name="outcome"><option value="applied">All statements applied</option><option value="failed">Migration incomplete / failed</option></select></label><label class="field"><span>Verification reason</span><textarea name="reason" required maxlength="2000"></textarea></label><button class="button button--danger" name="action" value="resolve" type="submit">Record outcome</button></form></details>{{end}}{{end}}
 </div></section>{{end}}
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Version / Attempt</th><th>Description</th><th>Executor</th><th>Time</th><th>Status</th><th>Progress</th></tr></thead><tbody>
{{range .History}}<tr><td><a href="{{link "/migrations" "db" $.Database.ID "id" .ID "offset" $.Offset}}">{{if .AppliedVersion}}v{{.AppliedVersion}}{{else}}Attempt #{{.ID}}{{end}}</a></td><td>{{.Description}}</td><td>{{.Username}}</td><td>{{stamp .StartedAt}}</td><td><span class="badge {{if eq .Status "succeeded"}}badge--success{{else if eq .Status "failed"}}badge--danger{{else}}badge--warning{{end}}">{{.Status}}</span></td><td>{{.CompletedStatements}} / {{.TotalStatements}}<small>{{.Mode}}</small></td></tr>{{else}}<tr><td colspan="6">No migration history yet.</td></tr>{{end}}
</tbody></table></div><footer class="pagination"><span>{{len .History}} attempts · offset {{.Offset}}</span><div>{{if gt .Offset 0}}<a class="button button--secondary button--small" href="{{link "/migrations" "db" .Database.ID "offset" .Previous}}">Previous</a>{{end}}{{if .HasMore}}<a class="button button--secondary button--small" href="{{link "/migrations" "db" .Database.ID "offset" .Next}}">Next</a>{{end}}</div></footer></section>
{{else}}<p class="empty-state">No databases assigned.</p>{{end}}
{{end}}
