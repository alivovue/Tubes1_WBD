{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Groups</h1><p>Kelola grup, anggota, dan akses database dalam satu halaman.</p></div><a class="button button--secondary" href="/admin/connections">Manage database connections</a></section>
<div class="notice"><div><strong>Highest permission wins</strong><p>No Access &lt; View Only &lt; View + Edit. Employees can join multiple groups. Platform admins also need group access to browse or change a database. Reducing or removing access requires affected users to sign in again.</p></div></div>
<section class="panel"><header class="panel__header"><h2>Create group</h2></header><form class="form-stack integration-form" method="post" action="/admin/groups"><input type="hidden" name="csrf" value="{{.CSRF}}" /><input type="hidden" name="action" value="save_group" /><div class="form-grid"><label class="field"><span>Name</span><input name="name" required maxlength="100" /></label><label class="field"><span>Description</span><input name="description" maxlength="2000" /></label></div><button class="button button--primary" type="submit">Create group</button></form></section>
<section class="group-grid group-grid--access" aria-label="Groups and database permissions">
{{range .Groups}}{{$group := .}}<article class="group-card"><header><div><h2>{{.Name}}</h2><p>{{.Description}}</p></div><span class="badge badge--neutral">{{len .Members}} members</span></header>
 <div class="group-card__body"><section class="group-members" aria-label="{{.Name}} members"><h3>Members</h3>
 <ul class="member-list">{{range .Members}}<li>{{.DisplayName}} <small>({{.Username}})</small></li>{{else}}<li>No members yet.</li>{{end}}</ul>
 <form class="form-stack" method="post" action="/admin/groups"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="membership" /><input type="hidden" name="id" value="{{.ID}}" /><label class="field"><span>Employee</span><select name="user" required>{{range $.Admin.Users}}<option value="{{.ID}}">{{.DisplayName}} ({{.Username}})</option>{{end}}</select></label><label class="field"><span>Membership</span><select name="member"><option value="yes">Add to group</option><option value="no">Remove from group</option></select></label><button class="button button--secondary button--small" type="submit">Update membership</button></form>
 <details><summary>Edit group</summary><form class="form-stack inline-editor" method="post" action="/admin/groups"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="save_group" /><input type="hidden" name="id" value="{{.ID}}" /><label class="field"><span>Name</span><input name="name" value="{{.Name}}" required maxlength="100" /></label><label class="field"><span>Description</span><input name="description" value="{{.Description}}" maxlength="2000" /></label><button class="button button--primary button--small" type="submit">Save group</button></form></details>
 <form method="post" action="/admin/groups" data-confirm="Delete this group and its memberships and database grants?"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="delete_group" /><input type="hidden" name="id" value="{{.ID}}" /><button class="button button--danger button--small" type="submit">Delete group</button></form>
 </section><section class="group-access workflow-scroll-target" id="group-access-{{.ID}}" tabindex="-1" aria-label="{{.Name}} database permissions"{{if .FocusPermissions}} data-auto-scroll{{end}}><h3>Database access</h3><p class="muted">Assign a permission for each database. New groups start with No Access.</p>
 <div class="table-wrap"><table class="data-table group-access-table"><thead><tr><th>Database</th><th>Permission</th></tr></thead><tbody>
 {{range .Grants}}<tr><td><strong>{{.Database.Name}}</strong><small class="group-access__database-type">{{.Database.DBMS}}{{if not .Database.Active}} · Disabled{{end}}</small></td><td><form class="group-access__form" method="post" action="/admin/groups"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="set_grant" /><input type="hidden" name="id" value="{{$group.ID}}" /><input type="hidden" name="db" value="{{.Database.ID}}" /><select class="permission-select" name="permission" aria-label="{{$group.Name}} {{.Database.Name}}"><option value="" {{if eq .Permission ""}}selected{{end}}>No Access</option><option value="view_only" {{if eq .Permission "view_only"}}selected{{end}}>View Only</option><option value="view_edit" {{if eq .Permission "view_edit"}}selected{{end}}>View + Edit</option></select><button class="button button--secondary button--small" type="submit">Save</button></form></td></tr>{{else}}<tr><td colspan="2">No database connections registered. <a href="/admin/connections">Register a connection</a> to assign access.</td></tr>{{end}}
 </tbody></table></div></section></div>
</article>{{else}}<p class="empty-state">Create a group to start assigning database access.</p>{{end}}
</section>
{{end}}
