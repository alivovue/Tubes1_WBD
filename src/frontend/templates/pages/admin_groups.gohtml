{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Groups</h1><p>Kelola grup, anggota, dan akses database dalam satu halaman.</p></div><a class="button button--secondary" href="/admin/connections">Manage database connections</a></section>
<div class="notice"><div><strong>Highest permission wins</strong><p>No Access &lt; View Only &lt; View + Edit. Employees can join multiple groups. Platform admins also need group access to browse or change a database. Reducing or removing access requires affected users to sign in again.</p></div></div>
<section class="panel"><header class="panel__header"><h2>Create group</h2></header><form class="form-stack integration-form" method="post" action="/admin/groups"><input type="hidden" name="csrf" value="{{.CSRF}}" /><input type="hidden" name="action" value="save_group" /><div class="form-grid"><label class="field"><span>Name</span><input name="name" required maxlength="100" /></label><label class="field"><span>Description</span><input name="description" maxlength="2000" /></label></div><button class="button button--primary" type="submit">Create group</button></form></section>
<section class="group-grid group-grid--access" aria-label="Groups and database permissions">
{{range .Groups}}{{$group := .}}
<article class="group-card workflow-scroll-target" id="group-{{.ID}}" tabindex="-1" data-group-card{{if .Focus}} data-auto-scroll{{end}}>
 <header><div><h2>{{.Name}}</h2><p>{{if .Description}}{{.Description}}{{else}}No description.{{end}}</p></div><span class="badge badge--neutral">{{len .Members}} members</span></header>
 <div class="group-card__body" data-group-overview>
  <section class="group-members" aria-label="{{.Name}} members"><h3>Members</h3>
   <ul class="member-list">{{range .Members}}<li>{{.DisplayName}} <small>({{.Username}})</small></li>{{else}}<li>No members yet.</li>{{end}}</ul>
  </section>
  <section class="group-access" aria-label="{{.Name}} database access summary"><h3>Database access</h3>
   <div class="table-wrap"><table class="data-table group-access-table"><thead><tr><th>Database</th><th>Permission</th></tr></thead><tbody>
    {{range .Grants}}<tr><td><strong>{{.Database.Name}}</strong><small class="group-access__database-type">{{.Database.DBMS}}{{if not .Database.Active}} &middot; Disabled{{end}}</small></td><td>{{if eq .Permission "view_edit"}}<span class="badge group-permission--edit">View + Edit</span>{{else if eq .Permission "view_only"}}<span class="badge group-permission--view">View Only</span>{{else}}<span class="badge badge--neutral">No Access</span>{{end}}</td></tr>{{else}}<tr><td colspan="2">No database connections registered.</td></tr>{{end}}
   </tbody></table></div>
  </section>
 </div>
 <div class="group-card__actions" role="group" aria-label="Edit {{.Name}}">
  <button class="button button--secondary button--small" type="button" data-group-edit="membership" aria-controls="group-membership-{{.ID}}" aria-expanded="{{if eq .Editor "membership"}}true{{else}}false{{end}}">Edit membership</button>
  <button class="button button--secondary button--small" type="button" data-group-edit="access" aria-controls="group-access-{{.ID}}" aria-expanded="{{if eq .Editor "access"}}true{{else}}false{{end}}">Edit access</button>
  <button class="button button--secondary button--small" type="button" data-group-edit="information" aria-controls="group-information-{{.ID}}" aria-expanded="{{if eq .Editor "information"}}true{{else}}false{{end}}">Edit group</button>
 </div>
 <section class="group-editor" id="group-membership-{{.ID}}" data-group-panel="membership" aria-labelledby="group-membership-title-{{.ID}}"{{if ne .Editor "membership"}} hidden{{end}}>
  <div class="group-editor__heading"><h3 id="group-membership-title-{{.ID}}" tabindex="-1">Edit membership</h3><button class="button button--secondary button--small" type="button" data-group-close>Close</button></div>
  <form class="form-stack" method="post" action="/admin/groups" data-group-save><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="membership" /><input type="hidden" name="id" value="{{.ID}}" /><label class="field"><span>Employee</span><select name="user" required>{{range $.Admin.Users}}<option value="{{.ID}}">{{.DisplayName}} ({{.Username}})</option>{{end}}</select></label><label class="field"><span>Membership</span><select name="member"><option value="yes">Add to group</option><option value="no">Remove from group</option></select></label><button class="button button--secondary button--small" type="submit">Update membership</button></form>
 </section>
 <section class="group-editor group-access" id="group-access-{{.ID}}" data-group-panel="access" aria-labelledby="group-access-title-{{.ID}}"{{if ne .Editor "access"}} hidden{{end}}>
  <div class="group-editor__heading"><h3 id="group-access-title-{{.ID}}" tabindex="-1">Edit database access</h3><button class="button button--secondary button--small" type="button" data-group-close>Close</button></div>
  <p class="muted">Assign a permission for each database, then save all changes together.</p>
  <form class="form-stack group-access__editor" method="post" action="/admin/groups" data-group-save>
   <input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="set_grants" /><input type="hidden" name="id" value="{{.ID}}" />
   <div class="table-wrap"><table class="data-table group-access-table"><thead><tr><th>Database</th><th>Permission</th></tr></thead><tbody>
    {{range .Grants}}<tr><td><strong>{{.Database.Name}}</strong><small class="group-access__database-type">{{.Database.DBMS}}{{if not .Database.Active}} &middot; Disabled{{end}}</small></td><td><input type="hidden" name="db" value="{{.Database.ID}}" /><select class="permission-select" name="permission" aria-label="{{$group.Name}} {{.Database.Name}}"><option value="" {{if eq .Permission ""}}selected{{end}}>No Access</option><option value="view_only" {{if eq .Permission "view_only"}}selected{{end}}>View Only</option><option value="view_edit" {{if eq .Permission "view_edit"}}selected{{end}}>View + Edit</option></select></td></tr>{{else}}<tr><td colspan="2">No database connections registered. <a href="/admin/connections">Register a connection</a> to assign access.</td></tr>{{end}}
   </tbody></table></div>
   {{if .Grants}}<button class="button button--primary button--small" type="submit">Save access</button>{{end}}
  </form>
 </section>
 <section class="group-editor" id="group-information-{{.ID}}" data-group-panel="information" aria-labelledby="group-information-title-{{.ID}}"{{if ne .Editor "information"}} hidden{{end}}>
  <div class="group-editor__heading"><h3 id="group-information-title-{{.ID}}" tabindex="-1">Edit group information</h3><button class="button button--secondary button--small" type="button" data-group-close>Close</button></div>
  <form class="form-stack inline-editor" method="post" action="/admin/groups" data-group-save><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="save_group" /><input type="hidden" name="id" value="{{.ID}}" /><label class="field"><span>Name</span><input name="name" value="{{.Name}}" required maxlength="100" /></label><label class="field"><span>Description</span><input name="description" value="{{.Description}}" maxlength="2000" /></label><button class="button button--primary button--small" type="submit">Save group</button></form>
  <div class="group-editor__delete"><form method="post" action="/admin/groups" data-confirm="Delete this group and its memberships and database grants?"><input type="hidden" name="csrf" value="{{$.CSRF}}" /><input type="hidden" name="action" value="delete_group" /><input type="hidden" name="id" value="{{.ID}}" /><button class="button button--danger button--small" type="submit">Delete group</button></form></div>
 </section>
</article>
{{else}}<p class="empty-state">Create a group to start assigning database access.</p>{{end}}
</section>
{{end}}
