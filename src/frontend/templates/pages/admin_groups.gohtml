{{define "content"}}
<section class="page-heading"><div><p class="eyebrow">Administration</p><h1>Groups</h1><p>Atur pengelompokan karyawan untuk pemberian akses database.</p></div><button class="button button--primary" type="button" data-toast="Form group memerlukan endpoint backend."><svg><use href="#icon-plus"></use></svg>Create group</button></section>
<section class="group-grid">
  <article class="group-card"><header><span class="group-icon group-icon--blue"><svg><use href="#icon-layers"></use></svg></span><button class="row-action" type="button" aria-label="Platform Engineering actions">•••</button></header><h2>Platform Engineering</h2><p>Core infrastructure and internal platform maintainers.</p><div class="member-stack" aria-label="5 members"><i class="avatar avatar--tiny">IN</i><i class="avatar avatar--tiny avatar--pink">NS</i><i class="avatar avatar--tiny avatar--violet">RM</i><i class="avatar avatar--tiny avatar--green">AS</i><span>+1</span></div><footer><span><strong>5</strong> members</span><a href="/admin/access">View access <svg><use href="#icon-arrow"></use></svg></a></footer></article>
  <article class="group-card"><header><span class="group-icon group-icon--pink"><svg><use href="#icon-layers"></use></svg></span><button class="row-action" type="button" aria-label="Data Engineering actions">•••</button></header><h2>Data Engineering</h2><p>Data pipelines, warehouse, and analytics maintainers.</p><div class="member-stack" aria-label="7 members"><i class="avatar avatar--tiny avatar--pink">NS</i><i class="avatar avatar--tiny avatar--green">AS</i><i class="avatar avatar--tiny avatar--violet">RM</i><span>+4</span></div><footer><span><strong>7</strong> members</span><a href="/admin/access">View access <svg><use href="#icon-arrow"></use></svg></a></footer></article>
  <article class="group-card"><header><span class="group-icon group-icon--violet"><svg><use href="#icon-layers"></use></svg></span><button class="row-action" type="button" aria-label="Backend actions">•••</button></header><h2>Backend</h2><p>Product API and service development team.</p><div class="member-stack" aria-label="9 members"><i class="avatar avatar--tiny avatar--violet">RM</i><i class="avatar avatar--tiny">IN</i><i class="avatar avatar--tiny avatar--muted">DP</i><span>+6</span></div><footer><span><strong>9</strong> members</span><a href="/admin/access">View access <svg><use href="#icon-arrow"></use></svg></a></footer></article>
  <article class="group-card"><header><span class="group-icon group-icon--green"><svg><use href="#icon-layers"></use></svg></span><button class="row-action" type="button" aria-label="Analytics actions">•••</button></header><h2>Analytics</h2><p>Business intelligence and read-only reporting users.</p><div class="member-stack" aria-label="6 members"><i class="avatar avatar--tiny avatar--muted">DP</i><i class="avatar avatar--tiny avatar--pink">NS</i><span>+4</span></div><footer><span><strong>6</strong> members</span><a href="/admin/access">View access <svg><use href="#icon-arrow"></use></svg></a></footer></article>
</section>
{{end}}
