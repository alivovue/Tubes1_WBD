{{define "topbar"}}
<header class="topbar">
  <div class="topbar__left">
    <button class="icon-button topbar__menu" type="button" data-sidebar-toggle aria-expanded="false" aria-label="Buka navigasi">
      <svg><use href="#icon-menu"></use></svg>
    </button>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span>{{.Section}}</span><svg><use href="#icon-chevron"></use></svg><strong>{{.Title}}</strong>
    </nav>
  </div>
  <div class="topbar__actions">
    <span class="system-status"><i></i>Workspace connected</span>
    <div class="avatar" aria-label="{{.User.DisplayName}}">{{initials .User.DisplayName}}</div>
  </div>
</header>
{{end}}
