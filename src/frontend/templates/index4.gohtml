<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medsos</title>
    <link rel="stylesheet" href="common.css" />
    <link rel="stylesheet" href="style4.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    />
  </head>
  <body class="social-page">
    <main class="social-hero">
      {{template "navigation" .}}
      <a href="#" class="search"><i class="fas fa-search"></i></a>
      <div class="image"></div>
      <div class="container2">
        <a
          href="https://www.facebook.com/profile.php?id=100026428245552&locale=id_ID"
          >Facebook
        </a>
        <a href="https://www.instagram.com/ishak_napitupulu/">Instagram</a>
        <a href="https://github.com/Ishakpln">GitHub</a>
      </div>
    </main>
    <div class="border">
      <div class="border1"></div>
      <div class="border2"></div>
    </div>
    {{template "footer" .}}
  </body>
</html>
