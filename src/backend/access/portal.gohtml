{{define "portal"}}<!DOCTYPE html>
<html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}} · Schakker</title><link rel="stylesheet" href="/portal.css"></head>
<body>
<header><a class="brand" href="/">Schakker<span>.</span></a><span>Internal Database Platform</span>{{if .User.ID}}<div class="account">{{.User.DisplayName}} · {{if .User.IsAdmin}}Platform Admin{{else}}Karyawan{{end}}<form action="/logout" method="post"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><button class="secondary">Keluar</button></form></div>{{end}}</header>
{{if .User.ID}}<nav><a href="/">Dashboard</a><a href="/databases">Database Saya</a>{{if .User.IsAdmin}}<a href="/admin/users">Karyawan</a><a href="/admin/groups">Grup</a><a href="/admin/databases">Koneksi Database</a><a href="/admin/access">Akses Database</a>{{end}}</nav>{{end}}
<main{{if eq .Page "login"}} class="login"{{end}}>
{{if eq .Page "login"}}
<section class="card"><p class="eyebrow">PORTAL KARYAWAN</p><h1>Masuk ke Schakker</h1><p>Gunakan akun yang diberikan oleh admin.</p>{{if .Error}}<p role="alert" class="error">{{.Error}}</p>{{end}}
<form action="/login" method="post"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Username<input name="username" required maxlength="100" autocomplete="username" autofocus></label><label>Password<input type="password" name="password" required maxlength="72" autocomplete="current-password"></label><button>Masuk</button></form><p class="muted">Belum punya akun? Hubungi Platform Admin.</p></section>
{{else}}
<p class="eyebrow">SCHAKKER WORKSPACE</p><h1>{{.Title}}</h1>
{{if eq .Page "dashboard"}}
<section class="card"><h2>Selamat datang, {{.User.DisplayName}}</h2><p>Akses database sesuai izin grup yang diberikan kepada akunmu.</p><a class="button" href="/databases">Buka Database Saya</a></section>
{{if .User.IsAdmin}}<section class="card"><h2>Administrasi platform</h2><p>Kelola akun karyawan, grup, koneksi, dan hak akses. Role admin tidak otomatis memberikan akses ke isi database.</p><div class="actions"><a href="/admin/users">Kelola karyawan →</a><a href="/admin/groups">Kelola grup →</a><a href="/admin/databases">Kelola koneksi →</a><a href="/admin/access">Atur akses →</a></div></section>{{end}}
{{end}}
{{if eq .Page "databases"}}
<p>Hanya database yang diizinkan melalui keanggotaan grupmu yang ditampilkan.</p><div class="grid">{{range .Databases}}<section class="card"><span class="badge">PostgreSQL</span><h2>{{.Name}}</h2><p>{{if eq .Permission "view_edit"}}View + Edit{{else}}View Only{{end}}</p></section>{{else}}<section class="card"><h2>Belum ada database</h2><p>Hubungi admin untuk mendapatkan keanggotaan grup dan akses database.</p></section>{{end}}</div>
{{end}}
{{if eq .Page "users"}}
<p>Perubahan password, role, atau status mencabut semua session karyawan terkait. Minimal satu admin harus tetap aktif.</p>
<details class="card" open><summary>Tambah karyawan</summary><form action="/admin/users/create" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Username<input name="username" required minlength="3" maxlength="100" pattern="[a-zA-Z0-9][a-zA-Z0-9_.-]{2,99}" autocomplete="off"></label><label>Nama tampilan<input name="display_name" required maxlength="150"></label><label>Password awal (12–72 byte)<input type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password"></label><label class="check"><input type="checkbox" name="admin"> Platform Admin</label><button>Buat akun</button></form></details>
{{range .Admin.Users}}<section class="card"><h2>{{.Username}} <span class="badge">{{if .Active}}Aktif{{else}}Nonaktif{{end}}</span></h2><form action="/admin/users/update" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}"><label>Nama tampilan<input name="display_name" value="{{.DisplayName}}" required maxlength="150"></label><label>Password baru (kosongkan untuk mempertahankan)<input type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password"></label><label class="check"><input type="checkbox" name="admin" {{if .IsAdmin}}checked{{end}}> Platform Admin</label><label class="check"><input type="checkbox" name="active" {{if .Active}}checked{{end}}> Akun aktif</label><button>Simpan akun</button></form></section>{{end}}
{{end}}
{{if eq .Page "groups"}}
<p>Karyawan bisa menjadi anggota beberapa grup. Perubahan keanggotaan mengharuskan karyawan terkait login kembali.</p>
<section class="card"><h2>Buat grup</h2><form action="/admin/groups/save" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Nama grup<input name="name" required maxlength="100"></label><label>Deskripsi<input name="description" maxlength="2000"></label><button>Buat grup</button></form></section>
{{range .Admin.Groups}}<section class="card"><h2>{{.Name}}</h2><form action="/admin/groups/save" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}"><label>Nama<input name="name" value="{{.Name}}" required maxlength="100"></label><label>Deskripsi<input name="description" value="{{.Description}}" maxlength="2000"></label><button>Simpan grup</button></form><form action="/admin/groups/delete" method="post"><input type="hidden" name="csrf_token" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}"><button class="danger">Hapus grup beserta keanggotaan dan izinnya</button></form></section>{{end}}
<section class="card"><h2>Atur keanggotaan</h2><form action="/admin/memberships" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Karyawan<select name="user_id" required>{{range .Admin.Users}}<option value="{{.ID}}">{{.Username}} — {{.DisplayName}}</option>{{end}}</select></label><label>Grup<select name="group_id" required>{{range .Admin.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></label><label class="check"><input type="checkbox" name="member" checked> Anggota (hapus centang untuk mengeluarkan)</label><button>Simpan keanggotaan</button></form>
<h3>Keanggotaan saat ini</h3><ul>{{range .Admin.Memberships}}<li>{{$m := .}}{{range $.Admin.Users}}{{if eq .ID $m.UserID}}{{.Username}}{{end}}{{end}} → {{range $.Admin.Groups}}{{if eq .ID $m.GroupID}}{{.Name}}{{end}}{{end}}</li>{{else}}<li>Belum ada keanggotaan.</li>{{end}}</ul></section>
{{end}}
{{if eq .Page "access"}}
<p>Izin tertinggi dari seluruh grup berlaku: No Access &lt; View Only &lt; View + Edit. Izin dihitung terpisah untuk setiap database, termasuk untuk admin.</p>
<section class="card"><h2>Atur izin grup</h2><form action="/admin/grants" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Grup<select name="group_id" required>{{range .Admin.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></label><label>Database<select name="database_id" required>{{range .Admin.Databases}}<option value="{{.ID}}">{{.Name}}{{if not .Active}} (nonaktif){{end}}</option>{{end}}</select></label><label>Izin<select name="permission"><option value="">No Access — cabut izin</option><option value="view_only">View Only</option><option value="view_edit">View + Edit</option></select></label><button>Simpan izin</button></form></section>
<section class="card"><h2>Izin saat ini</h2><table><thead><tr><th>Grup</th><th>Database</th><th>Izin</th></tr></thead><tbody>{{range .Admin.Grants}}<tr>{{$g := .}}<td>{{range $.Admin.Groups}}{{if eq .ID $g.GroupID}}{{.Name}}{{end}}{{end}}</td><td>{{range $.Admin.Databases}}{{if eq .ID $g.DatabaseID}}{{.Name}}{{end}}{{end}}</td><td>{{if eq .Permission "view_edit"}}View + Edit{{else}}View Only{{end}}</td></tr>{{else}}<tr><td colspan="3">Belum ada izin.</td></tr>{{end}}</tbody></table></section>
{{end}}
{{if eq .Page "database-admin"}}
{{template "connections" .}}
{{end}}
{{if eq .Page "error"}}<section class="card"><p role="alert" class="error">{{.Error}}</p><a href="/admin/databases">Kembali ke koneksi database</a></section>{{end}}
{{end}}</main><footer>Schakker · Portal internal karyawan</footer></body></html>{{end}}

{{define "connections"}}
<p>Daftarkan target PostgreSQL dan berikan akses melalui grup. Koneksi diuji sebelum disimpan. Menonaktifkan koneksi mempertahankan catatan riwayatnya.</p>
<section class="card"><h2>Tambah koneksi</h2><form action="/admin/databases/save" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Nama koneksi<input name="name" required maxlength="150"></label><label>Host<input name="host" required maxlength="255" placeholder="localhost"></label><label>Port<input name="port" type="number" value="5432" min="1" max="65535" required></label><label>Nama database<input name="database_name" required maxlength="100"></label><label>Username database<input name="db_username" required maxlength="100" autocomplete="off"></label><label>Password database<input type="password" name="password" maxlength="4096" autocomplete="new-password"></label><label>TLS<select name="sslmode"><option value="verify-full">verify-full (produksi)</option><option value="require">require</option><option value="disable">disable (lokal)</option></select></label><label class="check"><input type="checkbox" name="active" checked> Aktif</label><button>Uji & simpan koneksi</button></form></section>
{{range .Admin.Databases}}<section class="card"><h2>{{.Name}} <span class="badge">{{if .Active}}Aktif{{else}}Nonaktif{{end}}</span></h2><form action="/admin/databases/save" method="post" class="fields"><input type="hidden" name="csrf_token" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}"><label>Nama koneksi<input name="name" value="{{.Name}}" required maxlength="150"></label><label>Host<input name="host" value="{{.Host}}" required maxlength="255"></label><label>Port<input type="number" name="port" value="{{.Port}}" required min="1" max="65535"></label><label>Nama database<input name="database_name" value="{{.DatabaseName}}" required maxlength="100"></label><label>Username database<input name="db_username" required maxlength="100" autocomplete="off"></label><label>Password baru (kosongkan untuk mempertahankan)<input type="password" name="password" maxlength="4096" autocomplete="new-password"></label><label>TLS<select name="sslmode"><option value="verify-full" {{if eq .SSLMode "verify-full"}}selected{{end}}>verify-full</option><option value="require" {{if eq .SSLMode "require"}}selected{{end}}>require</option><option value="disable" {{if eq .SSLMode "disable"}}selected{{end}}>disable (lokal)</option></select></label><label class="check"><input type="checkbox" name="active" {{if .Active}}checked{{end}}> Aktif</label><button>Uji & simpan perubahan</button></form><form action="/admin/databases/disable" method="post"><input type="hidden" name="csrf_token" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}"><button class="danger">Nonaktifkan koneksi</button></form></section>{{end}}
{{end}}
