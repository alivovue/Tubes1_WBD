SCHAKKER_PLATFORM_DATABASE_URL=
# Existing user-session/review signing key, 32 bytes encoded as hex or base64.
SCHAKKER_MASTER_KEY=
SCHAKKER_ENV=development
PORT=3000
SCHAKKER_CONTROL_PLANE_URL=http://127.0.0.1:3002
# Same private service credential configured in the admin application.
SCHAKKER_INTERNAL_TOKEN=
# Optional user-owned directory for reading an existing master.key in development.
# SCHAKKER_STATE_DIR=.schakker
