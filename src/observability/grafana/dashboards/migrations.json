{
  "id": null,
  "uid": "schakker-migrations",
  "title": "Schakker \u2014 queue, migrations and connection pools",
  "tags": [
    "schakker",
    "milestone2"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Jobs per status (durable, deduplicated)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "schakker-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status) (max by(operation,status) (schakker_jobs))",
          "legendFormat": "{{status}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Queue wait \u2014 p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "schakker-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(schakker_queue_wait_seconds_bucket[2m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by(le) (rate(schakker_queue_wait_seconds_bucket[2m])))",
