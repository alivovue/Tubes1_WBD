{
  "name": "schakker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "src/apps/user/frontend",
    "src/apps/admin/frontend",
    "src/shared/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:user": "npm run build --workspace=schakker-frontend",
    "build:admin": "npm run build --workspace=schakker-admin-frontend",
    "typecheck:shared": "npm run typecheck --workspace=@schakker/ui",
    "test:frontend": "npm run test:frontend:unit && npm run test:frontend:integration",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test:backend:unit && npm run test:backend:integration",
    "test:backend:unit": "go -C src/tests test ./unit/...",
    "test:backend:integration": "go -C src/tests test -count=1 -timeout=20m ./integration",
    "test:frontend:unit": "node src/tests/frontend/unit/run.mjs",
    "test:frontend:integration": "npm run build && node src/tests/frontend/application-ui.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
