            {
              "id": "go/uncontrolled-allocation-size",
              "name": "go/uncontrolled-allocation-size",
              "shortDescription": {
                "text": "Slice memory allocation with excessive size value"
              },
              "fullDescription": {
                "text": "Allocating memory for slices with the built-in make function from user-controlled sources can lead to a denial of service."
              },
              "defaultConfiguration": {
                "enabled": true,
